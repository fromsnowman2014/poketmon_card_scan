{
  "name": "poketmon-card-scan",
  "private": true,
  "version": "1.0.0",
  "description": "Free, kid-friendly Pokemon card scanner & price checker (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "names": "node scripts/build-names.mjs",
    "en-sets": "node scripts/build-en-sets.mjs",
    "ja-prices": "node scripts/build-ja-prices.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
